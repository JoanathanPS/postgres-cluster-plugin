# Copy to .env and replace every CHANGE_ME value:
#   Copy-Item .env.example .env
# .env is git-ignored. Avoid the characters " ' $ # and spaces in passwords
# (they need extra quoting in .env and postgres.cfg).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_admin

REPLICATION_USER=replicator
REPLICATION_PASSWORD=CHANGE_ME_replication
REPLICATION_SLOT=replica1_slot

# Account used by the Site24x7 plugin (LOGIN + pg_read_all_stats only)
MONITOR_USER=site24x7
MONITOR_PASSWORD=CHANGE_ME_monitor

# Host ports (bound to 127.0.0.1 only). Change if 5432/5433 are already in use.
PRIMARY_HOST_PORT=5432
REPLICA_HOST_PORT=5433
