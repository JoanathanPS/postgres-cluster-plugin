[global_configurations]
use_agent_python=0
redirect_output=1

[postgres_cluster]

# Required: IP address or internal DNS name for a reachable cluster seed
cluster_host="postgres-primary.prod.internal"

# Optional: default is 5432
# postgres_port="5432"

# Optional: default is 8008 when Patroni is used
# patroni_port="8008"

username="site24x7"
password="CHANGE_ME_monitor"

# Optional: default is postgres
# db="postgres"

# Monitoring mode: auto | standalone | cluster (default auto)
# - auto: automatically detects whether target is standalone or cluster
# - standalone: monitors independent database without requiring cluster topology
# - cluster: enforces cluster topology discovery and health evaluation
monitor_mode="auto"

# Advanced options
# cluster_type="auto"
# discover="auto"
# address_map=""
# replay_warn_seconds=60
# replay_warn_bytes=104857600
# failover_warn_seconds=900
# slot_warn_bytes=1073741824
# slot_critical_bytes=10737418240
