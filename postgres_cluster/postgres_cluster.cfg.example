[global_configurations]
use_agent_python=0
redirect_output=1

[postgres_cluster]
# =============================================================================
# 1. Essential Settings (Required for all clusters)
# =============================================================================
# Single cluster entry point: IP address or hostname of HAProxy VIP, load balancer,
# internal domain (e.g. postgres-cluster.corp), or any cluster node.
cluster_host="127.0.0.1"

# HAProxy Primary Write Port:
# Routes transparently to the current primary/leader (default: 5000 in production, 5500 in dev)
write_port=5000

# Database monitoring credentials (recommended role: pg_monitor)
username="site24x7"
password="CHANGE_ME_monitor"

# Database to connect to for stats collection (default: postgres)
database="postgres"


# =============================================================================
# 2. Custom Port Overrides (Only needed if NOT using standard ports)
# =============================================================================
# Target PostgreSQL database port (default: 5432)
# postgres_port=5432

# HAProxy Replica Read Port (default: 5001)
# read_port=5001

# HAProxy Stats / Discovery Interface (default: 7000 and /;csv)
# discovery_port=7000
# discovery_uri="/;csv"

# Patroni REST API port (default: 8008)
# patroni_port=8008


# =============================================================================
# 3. Optional Display & Mode Overrides
# =============================================================================
# Override cluster name in Site24x7 dashboard (defaults to Patroni cluster name)
# cluster_name="production-pg-cluster"

# Monitoring mode: auto | cluster | standalone (default: auto)
# - auto: automatically discovers HAProxy -> Patroni -> Native PostgreSQL
# - cluster: enforces cluster topology discovery and failover tracking
# - standalone: monitors independent database without requiring cluster topology
# monitor_mode="auto"


# =============================================================================
# 4. Enterprise Security (SSL / TLS Client Certificates)
# =============================================================================
# SSL mode: prefer | require | verify-ca | verify-full (default: prefer)
# sslmode="prefer"
# sslrootcert="/etc/ssl/certs/pg_ca.crt"
# sslcert="/etc/ssl/certs/pg_client.crt"
# sslkey="/etc/ssl/certs/pg_client.key"


# =============================================================================
# 5. Local Docker / NAT / Port-Forwarding (Dev & Testing Only)
# =============================================================================
# Address translation map (maps internal container host:port to agent host:port)
# address_map="pg-node1:5432=127.0.0.1:5441,pg-node2:5432=127.0.0.1:5442,pg-node3:5432=127.0.0.1:5443"

# Candidate port ranges when multiple containers are mapped to a single localhost IP
# patroni_ports="8001-8003"
# node_ports="5441-5443"
