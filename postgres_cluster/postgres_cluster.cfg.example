[global_configurations]
use_agent_python=0
redirect_output=1

[postgres_cluster]

# -----------------------------------------------------------------------------
# Single-Endpoint Discovery Architecture
# -----------------------------------------------------------------------------
# Provide a single reachable cluster entry point (HAProxy, load balancer, VIP,
# or any cluster node). The plugin auto-discovers backend PostgreSQL nodes and
# adapts across failovers without requiring per-node configuration.
cluster_host="127.0.0.1"

# Target PostgreSQL server port (default 5432)
# postgres_port="5432"

# HAProxy Write & Read Frontend Ports (when using HAProxy as entry point):
# write_port: routes to active primary/leader (e.g. 5500 or 5000)
# read_port: load-balances across replicas (e.g. 5501 or 5001)
# write_port=5500
# read_port=5501

# HAProxy Stats / Discovery Interface:
# discovery_port: HAProxy stats port (default 7000)
# discovery_uri: Stats endpoint URI (default /stats;csv)
# discovery_port=7000
# discovery_uri="/stats;csv"

# Patroni REST API candidate ports:
# Supports single port (8008), CSV ("8001,8002,8003"), or range ("8001-8003")
# patroni_ports="8001-8003"
# patroni_port=8008

# Discovered PostgreSQL node candidate ports:
# For multi-node environments mapped behind a single IP (e.g. port forwarding):
# Supports CSV ("5441,5442,5443") or range ("5441-5443")
# node_ports="5441-5443"

# Address translation map (optional override for containerized / NAT / K8s):
# Can map short ports (pg-node1=5441,pg-node2=5442) or host:port pairs
# address_map="pg-node1=5441,pg-node2=5442,pg-node3=5443"

# Monitoring credentials
username="site24x7"
password="CHANGE_ME_monitor"

# Optional database to connect to (default postgres)
# db="postgres"

# Monitoring mode: auto | standalone | cluster (default auto)
# - auto: automatically detects whether target is standalone or cluster
# - standalone: monitors independent database without requiring cluster topology
# - cluster: enforces cluster topology discovery and health evaluation
monitor_mode="auto"

# Advanced thresholds & options
# cluster_type="auto"
# discover="auto"
# replay_warn_seconds=60
# replay_warn_bytes=104857600
# failover_warn_seconds=900
# slot_warn_bytes=1073741824
# slot_critical_bytes=10737418240
